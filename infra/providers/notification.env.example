# Copy to an ignored .env.providers/notification.env; real values belong only in external secrets.
SMTP_HOST=smtp.example.invalid
SMTP_PORT=587
SMTP_USERNAME=REPLACE_ME
SMTP_PASSWORD=REPLACE_ME
MAIL_FROM=no-reply@example.invalid
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=AC_REPLACE_ME
TWILIO_API_KEY_SID=SK_REPLACE_ME
TWILIO_API_KEY_SECRET=REPLACE_ME
# Choose exactly one sender. Messaging Service is preferred when using a configured sender pool.
TWILIO_MESSAGING_SERVICE_SID=MG_REPLACE_ME
TWILIO_FROM=
