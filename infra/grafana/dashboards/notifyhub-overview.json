{
  "uid": "notifyhub-overview",
  "title": "NotifyHub Monitoring",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": [
    "notifyhub",
    "monitoring"
  ],
  "timezone": "browser",
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Service scrape health",
      "type": "stat",
      "description": "1 = scrape succeeds; 0 = down/auth/network failure. Missing data is not healthy.",
      "datasource": {
        "type": "prometheus",
        "uid": "notifyhub-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"notifyhub-services\"}",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "title": "Database snapshot health",
      "type": "stat",
      "description": "1 = database snapshot fresh. Query failure or data older than 90s produces 0 and NaN business gauges.",
      "datasource": {
        "type": "prometheus",
        "uid": "notifyhub-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "notifyhub_monitoring_database_up",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "title": "Committed delivery throughput",
      "type": "timeseries",
      "description": "Only committed terminal results; duplicates and rollback do not count. Counters reset on process restart.",
      "datasource": {
        "type": "prometheus",
        "uid": "notifyhub-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(channel,status) (rate(notifyhub_delivery_completed_total[5m]))",
          "legendFormat": "{{channel}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "title": "Delivery failure ratio",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "notifyhub-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(notifyhub_delivery_completed_total{status=\"FAILED\"}[5m])) / clamp_min(sum(rate(notifyhub_delivery_completed_total[5m])),0.001)",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
